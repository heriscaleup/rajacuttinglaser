# LaserCut Pro - Apache Configuration

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive on
    
    # Images
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # HTML
    ExpiresByType text/html "access plus 1 day"
    
    # Manifest and other files
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType text/xml "access plus 1 week"
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Force HTTPS (uncomment when SSL is ready)
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Consolidate duplicate Article Agent blog posts (301 Redirects to canonical URLs)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Group 1: Keunggulan Fiber Laser Besi & Stainless
    RewriteRule ^blog/(2026-07-22-keunggulan-fiber-laser-cutting-besi-stainless|2026-07-29-keunggulan-fiber-laser-cutting-besi-stainless-steel-2026-07)/?$ /blog/2026-07-15-keunggulan-fiber-laser-cutting-besi-stainless-steel/ [R=301,L]

    # Group 2: Toleransi Potong Laser Fiber
    RewriteRule ^blog/(2026-07-16-toleransi-potong-laser-fiber-presisi-2026-07|2026-07-30-standar-akurasi-toleransi-pemotongan-laser-fiber|2026-08-20-toleransi-potong-laser-fiber-seberapa-presisi-2026-08|2026-09-03-toleransi-presisi-fiber-laser-cutting)/?$ /blog/2026-07-23-toleransi-potong-laser-fiber-presisi-2026-07/ [R=301,L]

    # Group 3: Laser Cutting Stainless Steel 1-20mm Ketebalan & Daya
    RewriteRule ^blog/(2026-07-17-laser-cutting-stainless-steel-panduan-ketebalan-daya-2026-07|2026-07-31-laser-cutting-stainless-steel-panduan-ketebalan-daya-2026-07|2026-09-18-laser-cutting-stainless-steel-panduan-ketebalan-daya)/?$ /blog/2026-07-24-laser-cutting-stainless-steel-panduan-ketebalan-daya-2026-07/ [R=301,L]

    # Group 4: Industri yang Paling Butuh Jasa Laser Cutting Logam
    RewriteRule ^blog/(2026-07-18-industri-butuh-jasa-laser-cutting-logam|2026-07-25-industri-butuh-jasa-laser-cutting-logam-2026-07|2026-08-15-industri-butuh-jasa-laser-cutting-logam|2026-09-05-industri-butuh-laser-cutting-logam|2026-09-26-industri-yang-butuh-jasa-laser-cutting-logam)/?$ /blog/2026-08-01-industri-yang-butuh-jasa-laser-cutting-logam/ [R=301,L]

    # Group 5: Custom Spare Part Logam: Laser Cutting vs CNC
    RewriteRule ^blog/(2026-07-19-custom-spare-part-laser-cutting-lebih-cepat-dari-cnc|2026-07-26-custom-spare-part-fiber-laser-efisiensi-produksi|2026-08-02-custom-spare-part-logam-laser-cutting-vs-cnc|2026-08-09-custom-spare-part-logam-laser-cutting-vs-cnc|2026-08-30-custom-spare-part-logam-laser-cutting-vs-cnc-2026-08|2026-10-18-custom-spare-part-logam-laser-cutting-vs-cnc)/?$ /blog/2026-08-16-custom-spare-part-logam-laser-cutting-vs-cnc/ [R=301,L]

    # Group 6: Laser Cutting Aluminium: Tips Material & Setting
    RewriteRule ^blog/(2026-07-27-laser-cutting-aluminium-tips-material-setting|2026-08-03-laser-cutting-aluminium-tips-material-setting-2026-08|2026-09-07-laser-cutting-aluminium-tips-material-setting|2026-09-14-laser-cutting-aluminium-tips-material-setting|2026-10-05-laser-cutting-aluminium-tips-material-setting)/?$ /blog/2026-08-10-laser-aluminium-panduan-setting-fiber-laser-2026-08/ [R=301,L]

    # Group 7: ROI Laser Cutting untuk UKM Manufaktur Indonesia
    RewriteRule ^blog/2026-07-28-roi-laser-cutting-ukm-manufaktur/?$ /blog/2026-07-21-roi-laser-cutting-untuk-ukm-manufaktur-indonesia/ [R=301,L]
</IfModule>

# Remove trailing slashes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]
</IfModule>

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Prevent access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

